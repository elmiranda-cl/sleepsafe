// Resource script for SleepSafe
1 ICON "assets/sleepsafe.ico"

1 VERSIONINFO
FILEVERSION 0,1,3,0
PRODUCTVERSION 0,1,3,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "elmiranda-cl"
            VALUE "FileDescription", "SleepSafe - Thermal & Closed-Lid Protector"
            VALUE "FileVersion", "0.1.3.0"
            VALUE "InternalName", "sleepsafe"
            VALUE "LegalCopyright", "Copyright (c) 2026 elmiranda-cl"
            VALUE "OriginalFilename", "sleepsafe.exe"
            VALUE "ProductName", "SleepSafe"
            VALUE "ProductVersion", "0.1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
